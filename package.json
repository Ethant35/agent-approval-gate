{
  "name": "agent-approval-gate",
  "version": "0.1.0",
  "description": "Local policy and human approval gateway for agent actions",
  "author": "Ethan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "aag": "dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "scripts/build-native.mjs",
    "README.md",
    "POLICY.md",
    "SECURITY.md",
    "ARCHITECTURE.md",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build-native.mjs && tsc && vite build",
    "start": "node dist/cli.js serve",
    "test:e2e": "playwright test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
