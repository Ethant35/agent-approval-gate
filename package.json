{
  "name": "agent-approval-gate",
  "version": "1.0.0",
  "description": "Local policy and human approval gateway for agent actions",
  "author": "Ethan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "aag": "dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "scripts/build-native.mjs",
    "README.md",
    "POLICY.md",
    "SECURITY.md",
    "ARCHITECTURE.md",
    "examples",
    "docs",
    "ACCEPTANCE.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build-native.mjs && tsc && vite build",
    "start": "node dist/cli.js serve",
    "test:e2e": "playwright test",
    "prepare": "npm run build",
    "check": "tsc --noEmit && tsc --noEmit --jsx react-jsx --target ES2023 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types vite/client web/main.tsx",
    "format:check": "prettier --check src web tests scripts *.json *.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ethant35/agent-approval-gate.git"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ]
}
